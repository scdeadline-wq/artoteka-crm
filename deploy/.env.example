# === Поменять перед деплоем ===

# PostgreSQL
POSTGRES_USER=artoteka
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=artoteka

# MinIO
MINIO_ROOT_USER=artoteka
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
S3_BUCKET=artoteka-images
S3_ACCESS_KEY=artoteka
S3_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD

# JWT
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Public URL (для фронта)
PUBLIC_API_URL=https://api.artoteka.ru

# HTTPS (заполняет deploy/https-setup.sh). Пока DOMAIN пуст — работаем по HTTP на IP.
# DOMAIN=176-124-219-38.sslip.io
# API_DOMAIN=api.176-124-219-38.sslip.io
# PUBLIC_BASE_URL=https://api.176-124-219-38.sslip.io
# CORS_ORIGINS=https://176-124-219-38.sslip.io,http://localhost:3000

# AI — MixRoute (OpenAI-совместимый; OpenRouter забанен). Ключ общий для backend и бота.
MIXROUTE_API_KEY=
# Если api.mixroute.ai с сервера не открывается — зарубежный прокси: http://user:pass@host:port или socks5://...
AI_PROXY=
# Имена моделей — как в каталоге MixRoute (GET https://api.mixroute.ai/v1/models), без «google/».
# LLM_MODEL=gemini-2.5-flash               # анализ фото, биографии, перевод имён
# LLM_MOCKUP_MODEL=gemini-2.5-flash-image  # мокапы в интерьере (нужна image-модель)
# LLM_PARSE_MODEL=gemini-2.5-flash         # бот: разбор текста
# LLM_VOICE_MODEL=gemini-2.5-flash         # бот: голосовые (модель должна принимать input_audio)

# Telegram Bot (заполнить позже)
TELEGRAM_BOT_TOKEN=
