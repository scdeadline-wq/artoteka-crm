# HTTPS-фронт Артотеки на VPS. Шаблон: официальный образ nginx при старте
# подставляет ${DOMAIN} и ${API_DOMAIN} из окружения (envsubst трогает только
# заданные переменные, поэтому $host и прочие nginx-переменные остаются как есть).
# Включается через deploy/https-setup.sh, см. docker-compose.https.yml.

upstream backend {
    server backend:8000;
}

upstream frontend {
    server frontend:3000;
}

# --- HTTP: ACME-челлендж и редирект на HTTPS --------------------------------
server {
    listen 80;
    server_name ${API_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${API_DOMAIN}$request_uri;
    }
}

# Всё остальное, включая заход по голому IP и старые ссылки http://IP/s/…,
# уводим на основной домен.
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# --- API --------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/artoteka/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/artoteka/privkey.pem;

    # Фото и PDF с телефона
    client_max_body_size 50M;
    # AI-распознавание и генерация мокапов отвечают долго
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location / {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- Старые адреса (прошлые домены) → редирект на текущий -------------------
# LEGACY_DOMAINS — через пробел; заглушка legacy.invalid, если старых нет.
server {
    listen 443 ssl;
    http2 on;
    server_name ${LEGACY_DOMAINS};

    ssl_certificate     /etc/letsencrypt/live/artoteka/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/artoteka/privkey.pem;

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# --- Frontend ---------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/artoteka/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/artoteka/privkey.pem;

    location / {
        proxy_pass http://frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Другие сайты на этом же сервере (HomeOS и т.п.) — конфиги и статика лежат
# только на сервере, в deploy/nginx/sites/ и deploy/nginx/www/ (в git их нет).
include /etc/nginx/conf.d/sites/*.conf;
